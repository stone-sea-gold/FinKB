# FinKB 环境配置模板
#
# 用法：
#   1. 复制本文件为 config/.env
#        cp config/.env.example config/.env
#   2. 填入真实值
#   3. 确认 config/.env 未被 git 跟踪（.gitignore 已覆盖 .env）
#
# 注意：本文件（.env.example）会被提交；真正的 .env 不会。

# ── MinerU 在线解析（Phase 0 必需）─────────────────────────────
# 从 https://mineru.net/apiManage/token 获取
MINERU_API_TOKEN=

# 以下为可选覆盖，留空则使用代码默认值
# MINERU_BASE_URL=https://mineru.net
# MINERU_MODEL_VERSION=pipeline          # pipeline | vlm | MinerU-HTML
# MINERU_LANGUAGE=ch                     # PaddleOCR 语言码，中文是 ch 不是 zh
# MINERU_POLL_INTERVAL=3                 # 轮询间隔（秒）
# MINERU_POLL_TIMEOUT=900                # 轮询总超时（秒）

# ── LLM 抽取（Phase 1 才需要，现在留空）───────────────────────
# 补丁 P1 阶段 A 需要真实模型做语义对齐
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
