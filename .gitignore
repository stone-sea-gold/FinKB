# ── 虚拟环境 ────────────────────────────────────────────────
.venv/

# ── Windows 残留元数据 ──────────────────────────────────────
*:Zone.Identifier
*.Zone.Identifier
Thumbs.db
desktop.ini

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# ── 数据资产 ────────────────────────────────────────────────
# 原始年报 PDF 共约 40MB，不入库；抓取脚本与清单（manifest.csv）入库，
# 任何环境都能凭清单重新拉取
raw/*.pdf

# 派生数据：可由 parse 流程重建
finkb/data/parsed/
finkb/data/parent_store/
# 推理物化产物：可由 ontology infer 重建（tbox/abox/inferred.ttl + report）
finkb/data/ontology/
# 分批解析的中间产物：MinerU 原始下载，单份可达 80MB，只作临时中转
finkb/data/_*/
*.duckdb
*.npy
*.zip

# ── 配置与密钥 ──────────────────────────────────────────────
.env
*.env
!.env.example

# ── 日志与临时文件 ──────────────────────────────────────────
*.log
tmp/

# 调研临时目录：CAS 国标包解压等一次性素材
.scratch/

# 本地知识库注册表（用户导入记录，不入库）
finkb/data/library.json
# 解析中转目录（MinerU 下载/解压）
finkb/data/mineru_work/

# 临时脚本与产物
.tmp/

# ── 生成的知识库数据（不随仓库分发；用户用自己的年报建库）──────
finkb/data/
finkb/wiki_vault/

# 视频转写素材与对标报告（不提交）
docs/
FinKB-本体语义层对标报告.md

# Python 构建产物
build/
dist/

# ── 开发/规划材料（不随仓库分发）──────────────────────────
# 方案、问题记录、盘点等文档只留在本地
/CLAUDE.md
/FinKB-*.md
/docs/
# 开发语料清单与抓取脚本（用户用自己的年报建库）
/raw/
/scrape-*.mjs
/pull-*.mjs
/.scratch/
